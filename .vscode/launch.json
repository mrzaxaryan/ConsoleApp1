{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch ARM64 (debuggable)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/NoRWX/bin/Debug/net10.0/NoRWX.dll",
      "args": [],
      "cwd": "${workspaceFolder}/NoRWX/bin/Debug/net10.0",
      "console": "integratedTerminal",
      "stopAtEntry": false
    },
    {
      "name": "Run ARM64 (no debugger)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-arm64",
      "program": "${workspaceFolder}/NoRWX/bin/Debug/net10.0/win-arm64/NoRWX.exe",
      "args": [],
      "cwd": "${workspaceFolder}/NoRWX/bin/Debug/net10.0/win-arm64",
      "console": "integratedTerminal",
      "noDebug": true
    },
    {
      "name": "Launch x64 (debuggable)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-x64",
      "program": "${workspaceFolder}/NoRWX/bin/Debug/net10.0/win-x64/NoRWX.exe",
      "args": [],
      "cwd": "${workspaceFolder}/NoRWX/bin/Debug/net10.0/win-x64",
      "console": "integratedTerminal",
      "stopAtEntry": false,
      "targetArchitecture": "x86_64",
      "env": {
        "COMPlus_legacyCorruptedStateExceptionsPolicy": "1"
      }
    },
    {
      "name": "Run x64 (no debugger)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-x64",
      "program": "${workspaceFolder}/NoRWX/bin/Debug/net10.0/win-x64/NoRWX.exe",
      "args": [],
      "cwd": "${workspaceFolder}/NoRWX/bin/Debug/net10.0/win-x64",
      "console": "integratedTerminal",
      "noDebug": true
    },
    {
      "name": "Launch x86 (debuggable)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-x86",
      "program": "${workspaceFolder}/NoRWX/bin/Debug/net10.0/win-x86/NoRWX.exe",
      "args": [],
      "cwd": "${workspaceFolder}/NoRWX/bin/Debug/net10.0/win-x86",
      "console": "integratedTerminal",
      "stopAtEntry": false,
      "targetArchitecture": "x86",
      "env": {
        "COMPlus_legacyCorruptedStateExceptionsPolicy": "1"
      }
    },
    {
      "name": "Run x86 (no debugger)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-x86",
      "program": "${workspaceFolder}/NoRWX/bin/Debug/net10.0/win-x86/NoRWX.exe",
      "args": [],
      "cwd": "${workspaceFolder}/NoRWX/bin/Debug/net10.0/win-x86",
      "console": "integratedTerminal",
      "noDebug": true
    }
  ]
}
