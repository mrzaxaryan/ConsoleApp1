{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/NoRWX/NoRWX.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceNoAlign"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build-x64",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/NoRWX/NoRWX.csproj",
        "-r", "win-x64",
        "--self-contained",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceNoAlign"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "run-x64",
      "command": "dotnet",
      "type": "process",
      "args": [
        "run",
        "--project", "${workspaceFolder}/NoRWX/NoRWX.csproj",
        "-r", "win-x64",
        "--self-contained"
      ],
      "dependsOn": "build-x64",
      "problemMatcher": []
    }
  ]
}
